{
  "uid": "bobfull-overview",
  "title": "BobFull Overview",
  "tags": ["bobfull", "spring-boot", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend Up",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "up{job=\"bobfull-backend\"}", "instant": true}
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP Error Rate",
      "gridPos": {"x": 4, "y": 0, "w": 5, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"bobfull-backend\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"bobfull-backend\"}[5m])), 1)", "instant": true}
      ],
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 0.01}, {"color": "red", "value": 0.05}]}},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "API p95",
      "gridPos": {"x": 9, "y": 0, "w": 5, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"bobfull-backend\",uri!=\"/actuator/prometheus\"}[5m])))", "instant": true}
      ],
      "fieldConfig": {
        "defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 1}, {"color": "red", "value": 2}]}},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Critical Business Events",
      "gridPos": {"x": 14, "y": 0, "w": 5, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(increase(bobfull_business_events_total{event=~\"PAYMENT_COMPENSATION_REQUIRED|REFUND_COMPENSATION_REQUIRED|PORTONE_WEBHOOK_PROCESSING_FAILED|PAYMENT_WEBHOOK_PERMANENT_FAILURE|CHAT_ROOM_CREATION_REQUIRED|UNHANDLED_EXCEPTION\"}[5m]))", "instant": true}
      ],
      "fieldConfig": {
        "defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}},
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "DB Pending Connections",
      "gridPos": {"x": 19, "y": 0, "w": 5, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "max(hikaricp_connections_pending{job=\"bobfull-backend\"})", "instant": true}
      ],
      "fieldConfig": {
        "defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}},
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP Requests by Status",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"bobfull-backend\"}[1m]))"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "API p95 by URI",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (uri, le) (rate(http_server_requests_seconds_bucket{job=\"bobfull-backend\",uri!=\"/actuator/prometheus\"}[5m])))"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM Memory",
      "gridPos": {"x": 0, "y": 12, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (area) (jvm_memory_used_bytes{job=\"bobfull-backend\"})"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "JVM CPU",
      "gridPos": {"x": 8, "y": 12, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "process_cpu_usage{job=\"bobfull-backend\"}"},
        {"refId": "B", "expr": "system_cpu_usage{job=\"bobfull-backend\"}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "DB Connection Pool",
      "gridPos": {"x": 16, "y": 12, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "hikaricp_connections_active{job=\"bobfull-backend\"}"},
        {"refId": "B", "expr": "hikaricp_connections_idle{job=\"bobfull-backend\"}"},
        {"refId": "C", "expr": "hikaricp_connections_pending{job=\"bobfull-backend\"}"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Business Events by Event",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (event) (increase(bobfull_business_events_total[5m]))"}
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Login Failures",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(increase(bobfull_business_events_total{event=\"LOGIN_FAILED\"}[5m]))"}
      ]
    }
  ]
}
