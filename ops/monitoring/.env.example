# Monitoring EC2 Docker Compose settings.
# Copy to the Monitoring EC2 env file and fill actual values there.
# Set BACKEND_MONITORING_ENV_FILE to that absolute path in GitHub Variables.
# Do not commit real secrets.

# Initial Active App EC2 private IPs or private DNS names plus port.
# Blue-Green deploy updates this value on Monitoring EC2 after ALB switch.
BOBFULL_BACKEND_METRICS_TARGETS=10.0.1.10:8080,10.0.1.11:8080

# Fallback for the legacy single-target setup.
# Used only when BOBFULL_BACKEND_METRICS_TARGETS is empty.
# BOBFULL_BACKEND_METRICS_TARGET=10.0.0.10:8080

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=http://monitoring.example.internal:3000

# Slack Incoming Webhook URL and recipient for the monitoring channel.
# Replace with the real Slack monitoring channel values in Monitoring EC2 .env.
GRAFANA_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/with/webhook
GRAFANA_SLACK_RECIPIENT="#bobfull-monitoring"

# Images can be pinned after the first Monitoring EC2 verification.
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana-oss:latest
