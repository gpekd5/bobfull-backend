          "datasource": {
            "type": "mysql",
            "uid": "bobfull-local-mysql"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  analyzed_at AS time,\n  prompt_tokens AS value,\n  CONCAT(provider, ' / ', prompt_version, ' / ', result) AS metric\nFROM chat_moderation\nWHERE $__timeFilter(analyzed_at)\n  AND provider = 'OpenAI'\n  AND prompt_tokens IS NOT NULL\nORDER BY analyzed_at ASC",
