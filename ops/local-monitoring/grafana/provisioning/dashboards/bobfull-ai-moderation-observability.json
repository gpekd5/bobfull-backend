        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.4.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "(((sum(gen_ai_client_token_usage_total{gen_ai_system=\"openai\",gen_ai_request_model=\"gpt-4o-mini\",gen_ai_token_type=\"input\"}) or vector(0)) * 0.15) + ((sum(gen_ai_client_token_usage_total{gen_ai_system=\"openai\",gen_ai_request_model=\"gpt-4o-mini\",gen_ai_token_type=\"output\"}) or vector(0)) * 0.60)) / 1000000",
